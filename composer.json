{
    "name": "renedekat/verteller",
    "description": "Story-driven test scaffolding for PHPUnit. Sync Gherkin-like .story files to test stubs automatically.",
    "type": "library",
    "license": "MIT",
    "keywords": ["phpunit", "testing", "bdd", "gherkin", "story", "scaffolding"],
    "require": {
        "php": "^8.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Verteller\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Verteller\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/verteller.php"
    ],
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    }
}
